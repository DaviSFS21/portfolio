---
// Picks the template the project asks for.
import type { CollectionEntry } from 'astro:content';
import CaseStudy from './CaseStudy.astro';
import QuickProject from './QuickProject.astro';
import type { Locale } from '../../i18n/locales';

interface Props {
  entry: CollectionEntry<'projects'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
---

{entry.data.template === 'case-study' ? <CaseStudy entry={entry} locale={locale} /> : <QuickProject entry={entry} locale={locale} />}
